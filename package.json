{
  "name": "leave-tracker-backend",
  "version": "1.0.0",
  "description": "REST API for the Leave Tracker: leave requests, balances, holidays, approvals, email and live updates.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:demo": "node src/seed.js --demo",
