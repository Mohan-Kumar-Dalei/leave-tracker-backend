# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=leave_tracker

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# The browser addresses allowed to call this API, comma separated
CLIENT_ORIGINS=http://localhost:5173
# Used for links inside emails
APP_URL=http://localhost:5173
APP_NAME=Leave Tracker

# Set to true once the site runs on https
COOKIE_SECURE=false
# 1 when running behind nginx, 0 when not
TRUST_PROXY=0

# Leave rules
TIMEZONE=Asia/Kolkata
# Day numbers, 0 is Sunday and 6 is Saturday
WEEKEND_DAYS=0,6

# Email. Leave SMTP_HOST empty in development and mails are saved to .mail-outbox/
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Leave Tracker <no-reply@example.com>

# First admin, used by npm run seed. Passwords are stored only as bcrypt hashes, in single quotes.
# Make one with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your password"
SEED_ADMIN_NAME=HR Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH=
# Demo employees, used by npm run seed:demo. Development only.
SEED_EMPLOYEE_PASSWORD_HASH=
