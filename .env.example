# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=leave_tracker

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# The browser addresses allowed to call this API, comma separated
CLIENT_ORIGINS=http://localhost:5173
# Used for links inside emails
APP_URL=http://localhost:5173
APP_NAME=Leave Tracker

# Set to true once the site runs on https
COOKIE_SECURE=false
# 1 when running behind nginx, 0 when not
TRUST_PROXY=0

# Leave rules
TIMEZONE=Asia/Kolkata
# Weekly off days as numbers, 0 is Sunday and 6 is Saturday. Separate several with commas.
WEEKEND_DAYS=0

# Email. Leave SMTP_HOST empty in development and mails are saved to .mail-outbox/
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Leave Tracker <no-reply@example.com>

# Leave mails are written as the person (employee applies, admin replies in the
# same thread). They leave from this mailbox under that person's name, with
# Reply-To set to the person. Empty means SMTP_USER.
MAIL_ADDRESS=
# Copied on leave applications by default (the employee can change it), comma separated.
# Each entry is an address or Name <address>, for example: HR Operations <hr@example.com>
LEAVE_MAIL_CC=
LEAVE_MAIL_GREETING=Sir
# Used in the signature when an employee has no designation set
DEFAULT_DESIGNATION=Analyst

# Connect Gmail: people send leave mails from their own Gmail (Gmail API).
# Google Cloud > Google Auth Platform > Clients > Web application. Redirect URI:
#   <APP_URL>/api/auth/google/callback
# Leave all three empty to keep sending from the app's mailbox only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the saved Google tokens. 64 hex characters, made with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_KEY=
# Only if the callback is not APP_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Mail signature. The logo must be a PNG or JPG on https, mail apps do not show SVG.
COMPANY_NAME=Contify
COMPANY_LOGO_URL=
COMPANY_TRIAL_URL=https://www.contify.com/
COMPANY_DEMO_URL=https://www.contify.com/
COMPANY_LINKEDIN_URL=https://www.linkedin.com/company/contify

# First admin, used by npm run seed. Passwords are stored only as bcrypt hashes, in single quotes.
# Make one with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your password"
SEED_ADMIN_NAME=HR Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH=
# Demo employees, used by npm run seed:demo. Development only.
SEED_EMPLOYEE_PASSWORD_HASH=
